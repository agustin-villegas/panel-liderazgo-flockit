# ─── Base de datos ──────────────────────────────────────────────────────────
# Supabase → proyecto panel-liderazgo → Connect → Transaction pooler
DATABASE_URL=

# ─── Seguridad (generar valores aleatorios propios) ─────────────────────────
SESSION_SECRET=          # 32+ bytes aleatorios
ENCRYPTION_KEY=          # 32 bytes en base64 (cifra los tokens de Jira)
CRON_SECRET=             # secreto que manda pg_cron a /internal/jobs/*

# ─── Admin inicial ──────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=     # generar con: uv run scripts/generar_hash.py

# ─── IA (proveedor y modelo a definir) ──────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
AI_MODEL=

# ─── Front / passkeys ───────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
