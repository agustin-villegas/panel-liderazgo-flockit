# ════════════════════════════════════════════════════════════════
#  👉 COMPLETAR (solo estas 2 líneas, pegá el valor después del =)
# ════════════════════════════════════════════════════════════════

# Supabase → panel-liderazgo → Database → Settings → Reset database password
DB_PASSWORD=

# platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=


# ════════════════════════════════════════════════════════════════
#  ✅ YA CONFIGURADO (no tocar)
# ════════════════════════════════════════════════════════════════

# Base de datos (Supabase, pooler São Paulo)
DB_USER=postgres.<project-ref>
DB_HOST=aws-1-<region>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# Admin del panel 
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=   # uv run python scripts/generar_hash.py

# Secretos internos (generar valores propios)
SESSION_SECRET=   # 32+ caracteres al azar
ENCRYPTION_KEY=   # 32 bytes en base64
CRON_SECRET=   # 16+ caracteres al azar

# IA: el modelo se define más adelante
AI_MODEL=
GOOGLE_API_KEY=

# Local
FRONTEND_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
